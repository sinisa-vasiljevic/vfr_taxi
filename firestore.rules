rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMaster() { return signedIn() && request.auth.token.email == "v.sinisa@gmx.de"; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return isMaster() || (hasProfile() && role() == "admin"); }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid &&
        ((isMaster() && request.resource.data.role == "master") ||
         (request.resource.data.role == "user" && request.resource.data.email == request.auth.token.email));
      allow update: if isMaster() || (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isMaster() && request.auth.uid != uid;
    }

    match /invites/{code} {
      allow read: if isMaster() || (signedIn() && !resource.data.used && resource.data.email == request.auth.token.email);
      allow create, delete: if isMaster();
      allow update: if isMaster() || (signedIn() && !resource.data.used &&
        resource.data.email == request.auth.token.email && request.resource.data.used == true &&
        request.resource.data.usedBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["used","usedBy","usedAt"]));
    }

    match /vehicles/{id} {
      allow read: if hasProfile();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (hasProfile() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["km","fueled","cleaned","washed","openDamage","updatedAt"]));
    }
    match /bookings/{id} {
      allow read: if hasProfile();
      allow create: if isAdmin() || (hasProfile() && request.resource.data.status == "requested" && request.resource.data.trainerUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (hasProfile() && resource.data.status == "requested" && resource.data.trainerUid == request.auth.uid);
    }
    match /trips/{id} {
      allow read: if hasProfile();
      allow create: if hasProfile() && request.resource.data.userUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /damages/{id} {
      allow read: if hasProfile();
      allow create: if hasProfile() && request.resource.data.reportedByUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isMaster();
    }
  }
}
