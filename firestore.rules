rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMaster() { return signedIn() && request.auth.token.email == "v.sinisa@gmx.de"; }
    function hasActiveProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }
    function userRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return isMaster() || (hasActiveProfile() && userRole() == "admin"); }

    match /invites/{code} {
      allow get: if true;
      allow list, create, delete: if isMaster();
      allow update: if isMaster() || (
        signedIn()
        && resource.data.active == true
        && resource.data.used == false
        && resource.data.email == request.auth.token.email
        && request.resource.data.email == resource.data.email
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.active == false
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["active", "used", "usedAt", "usedBy"])
      );
    }

    match /users/{uid} {
      allow read: if isMaster() || hasActiveProfile();
      allow create: if isMaster()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["name", "email", "active", "role", "createdAt"])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.active == true
        && request.resource.data.role == "master";
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["name", "email", "active", "role", "inviteCode", "createdAt"])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.active == true
        && request.resource.data.role == "user"
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.active == true
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.used == false
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.email == request.auth.token.email
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.active == false
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.used == true
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.usedBy == request.auth.uid;
      allow update: if isMaster()
        && resource.data.role != "master"
        && request.resource.data.email == resource.data.email
        && request.resource.data.role in ["user", "admin"];
      allow delete: if isMaster() && request.auth.uid != uid && resource.data.role != "master";
    }

    match /vehicles/{vehicleId} {
      allow read: if isMaster() || hasActiveProfile();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        hasActiveProfile()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "km", "fueled", "cleaned", "washed", "flashed", "openDamage", "updatedAt"
        ])
      );
    }

    match /bookings/{bookingId} {
      allow read: if isMaster() || hasActiveProfile();
      allow create: if isAdmin() || (
        hasActiveProfile()
        && request.resource.data.status == "requested"
        && request.resource.data.trainerUid == request.auth.uid
      );
      allow update: if isAdmin() || (
        hasActiveProfile()
        && resource.data.trainerUid == request.auth.uid
        && resource.data.status == "requested"
        && request.resource.data.trainerUid == resource.data.trainerUid
        && request.resource.data.status == "requested"
      );
      allow delete: if isAdmin() || (
        hasActiveProfile()
        && resource.data.trainerUid == request.auth.uid
        && resource.data.status in ["requested", "reserved"]
      );
    }

    match /trips/{tripId} {
      allow read: if isMaster() || hasActiveProfile();
      allow create: if hasActiveProfile() && request.resource.data.userUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /damages/{damageId} {
      allow read: if isMaster() || hasActiveProfile();
      allow create: if hasActiveProfile() && request.resource.data.reportedByUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isMaster();
    }
  }
}
