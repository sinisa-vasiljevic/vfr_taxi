rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMaster() { return signedIn() && request.auth.token.email == "v.sinisa@gmx.de"; }
    function hasActiveProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true; }
    function userRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return isMaster() || (hasActiveProfile() && userRole() == "admin"); }
    function isBookingParticipant(bookingId) { return hasActiveProfile() && exists(/databases/$(database)/documents/bookings/$(bookingId)) && (get(/databases/$(database)/documents/bookings/$(bookingId)).data.trainerUid == request.auth.uid || get(/databases/$(database)/documents/bookings/$(bookingId)).data.driverUid == request.auth.uid); }
    match /invites/{code} {
      allow get: if true;
      allow list, create, delete: if isMaster();
      allow update: if isMaster() || (signedIn() && resource.data.active == true && resource.data.used == false && resource.data.email == request.auth.token.email && request.resource.data.email == resource.data.email && request.resource.data.name == resource.data.name && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.active == false && request.resource.data.used == true && request.resource.data.usedBy == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["active", "used", "usedAt", "usedBy"]));
    }
    match /users/{uid} {
      allow read: if isMaster() || hasActiveProfile();
      allow create: if isMaster() && request.auth.uid == uid && request.resource.data.keys().hasOnly(["name", "email", "active", "role", "createdAt"]) && request.resource.data.email == request.auth.token.email && request.resource.data.active == true && request.resource.data.role == "master";
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(["name", "email", "active", "role", "inviteCode", "createdAt"]) && request.resource.data.email == request.auth.token.email && request.resource.data.active == true && request.resource.data.role == "user" && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)) && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.active == true && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.used == false && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.email == request.auth.token.email && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.active == false && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.used == true && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.usedBy == request.auth.uid;
      allow update: if isMaster() && resource.data.role != "master" && request.resource.data.email == resource.data.email && request.resource.data.role in ["user", "admin"];
      allow delete: if isMaster() && request.auth.uid != uid && resource.data.role != "master";
    }
    match /vehicles/{vehicleId} {
      allow read: if isMaster() || hasActiveProfile();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (hasActiveProfile() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["km","currentLocation","fueled","cleaned","washed","flashed","openDamage","updatedAt"]));
    }
    match /bookings/{bookingId} {
      allow read: if isMaster() || hasActiveProfile();
      allow create: if isAdmin() || (hasActiveProfile() && request.resource.data.status == "requested" && request.resource.data.trainerUid == request.auth.uid);
      allow update: if isAdmin()
        || (hasActiveProfile() && resource.data.trainerUid == request.auth.uid && resource.data.status == "requested" && request.resource.data.trainerUid == resource.data.trainerUid && request.resource.data.status == "requested" && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["team","gameType","date","endDate","from","to","vehicleId","purpose","driverUid","driverName","driverType","updatedAt","updatedByUid","updatedByName"]))
        || (hasActiveProfile() && resource.data.status == "reserved" && request.resource.data.status == resource.data.status && request.resource.data.trainerUid == resource.data.trainerUid && request.resource.data.driverUid == resource.data.driverUid && (resource.data.trainerUid == request.auth.uid || resource.data.driverUid == request.auth.uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["tripStatus","tripId","tripStartedAt","tripEndedAt"]))
        || (hasActiveProfile() && resource.data.status == "reserved" && request.resource.data.status == resource.data.status && request.resource.data.trainerUid == resource.data.trainerUid && request.resource.data.driverUid == resource.data.driverUid && request.resource.data.tripStatus == "auto-closed" && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["tripStatus","tripEndedAt"]));
      allow delete: if isAdmin() || (hasActiveProfile() && resource.data.trainerUid == request.auth.uid && (resource.data.status == "requested" || (resource.data.status == "reserved" && !("tripStatus" in resource.data))));
    }
    match /trips/{tripId} {
      allow read: if isMaster() || hasActiveProfile();
      allow create: if isAdmin() || (hasActiveProfile() && request.resource.data.userUid == request.auth.uid && request.resource.data.bookingId is string && isBookingParticipant(request.resource.data.bookingId) && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == "reserved" && request.resource.data.status == "active");
      allow update: if isAdmin()
        || (resource.data.bookingId is string && isBookingParticipant(resource.data.bookingId) && resource.data.status == "active" && request.resource.data.bookingId == resource.data.bookingId && request.resource.data.vehicleId == resource.data.vehicleId && request.resource.data.status == "completed" && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","kmEnd","distance","endLocation","fueled","cleaned","washed","flashed","damageText","endedAt","updatedAt","updatedByUid","updatedByName","returnDataIncomplete"]))
        || (hasActiveProfile() && resource.data.status == "active" && request.resource.data.status == "auto-closed" && request.resource.data.bookingId == resource.data.bookingId && request.resource.data.vehicleId == resource.data.vehicleId && request.resource.data.autoCloseTriggeredByUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","kmEnd","distance","endedAt","updatedAt","updatedByUid","updatedByName","autoCloseReason","lastDriverName","autoCloseTrainerUid","autoCloseTrainerName","autoCloseDriverUid","autoCloseDriverName","autoCloseTriggeredByUid","autoCloseTriggeredBy","returnDataIncomplete"]));
      allow delete: if isAdmin();
    }
    match /damages/{damageId} {
      allow read: if isMaster() || hasActiveProfile();
      allow create: if hasActiveProfile() && request.resource.data.reportedByUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isMaster();
    }
  }
}
